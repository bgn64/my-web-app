# Used by Next.js on the host; Compose uses db instead.
PGHOST=127.0.0.1
PGDATABASE=tee_time
PGUSER=tee_time_app
PGPASSWORD=

# Generate a long, unique authentication secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Use production for deployments.
APP_ENV=development
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=compose.yaml,compose.${APP_ENV:-production}.yaml
